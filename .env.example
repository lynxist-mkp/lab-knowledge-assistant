# Copy this file to `.env` for local development.

# Ragas judge provider API key.
ZHIPUAI_API_KEY=your-zhipuai-api-key

# Optional DeepSeek API key for adapters that use DeepSeek.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional local service overrides.
LAB_KNOWLEDGE_GEMMA_PORT=8120
LAB_KNOWLEDGE_PADDLEOCR_MLX_PORT=8111
